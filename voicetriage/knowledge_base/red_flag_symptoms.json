      "action": "Alert emergency operator immediately. Do not queue."
    },
    "URGENT": {
      "label": "🟡 Urgent",
      "description": "Potentially serious. Needs doctor within 1 hour.",
      "response_time": "Within 1 hour",
      "action": "Prioritize in queue. Ensure doctor callback within 60 minutes."
    },
    "ROUTINE": {
      "label": "🟢 Routine",
      "description": "Non-urgent. Can wait for scheduled consultation.",
      "response_time": "Within 24 hours",
      "action": "Normal queue. Schedule next available appointment."
    }
  },

